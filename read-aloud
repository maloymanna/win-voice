#!/usr/bin/env bash
# read-aloud - Git Bash wrapper for read-aloud.py on Windows 11
# Place this file in the same directory as read-aloud.py, or in a folder
# in your PATH (e.g. ~/bin or ~/.local/bin).
#
# Usage from Git Bash:
#   read-aloud          # run the script
#   read-aloud stop     # stop any running instance

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_SCRIPT="${SCRIPT_DIR}/read-aloud.py"

# Find Python. Prefer pythonw (no console window), then python3, then python.
find_python() {
    if command -v pythonw &>/dev/null; then
        echo "pythonw"
    elif command -v python3 &>/dev/null; then
        echo "python3"
    elif command -v python &>/dev/null; then
        echo "python"
    else
        echo ""
    fi
}

PYTHON_EXE="$(find_python)"

if [[ -z "$PYTHON_EXE" ]]; then
    echo "Error: Could not find python, python3, or pythonw in PATH." >&2
    echo "Make sure Python is installed and available in Git Bash." >&2
    exit 1
fi

if [[ ! -f "$PYTHON_SCRIPT" ]]; then
    echo "Error: read-aloud.py not found at: $PYTHON_SCRIPT" >&2
    echo "Make sure read-aloud.py is in the same directory as this wrapper." >&2
    exit 1
fi

# Handle explicit stop command
if [[ "${1:-}" == "stop" ]]; then
    PIDFILE="${TEMP:-/tmp}/read-aloud.pid"
    if [[ -f "$PIDFILE" ]]; then
        pid="$(cat "$PIDFILE" 2>/dev/null || true)"
        if [[ -n "$pid" ]]; then
            # Use taskkill for Windows PIDs
            taskkill //PID "$pid" //T //F 2>/dev/null || true
            rm -f "$PIDFILE"
            echo "Read Aloud stopped."
        fi
    else
        echo "No running Read Aloud instance found."
    fi
    exit 0
fi

# Run the Python script. pythonw will not show a console window.
exec "$PYTHON_EXE" "$PYTHON_SCRIPT" "$@"
